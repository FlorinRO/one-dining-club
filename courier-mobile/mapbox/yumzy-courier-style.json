            "hsl(0, 0%, 100%)",
            "yellow",
            "hsl(50, 100%, 70%)",
            "orange",
            "hsl(25, 100%, 75%)",
            "blue",
            "hsl(230, 57%, 44%)",
            "red",
            "hsl(0, 87%, 59%)",
            "green",
            "hsl(140, 74%, 37%)",
            "hsl(230, 18%, 13%)"
