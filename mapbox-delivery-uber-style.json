{
  "version": 8,
  "name": "Delivery Clean Dark-on-Light",
  "metadata": {
    "mapbox:autocomposite": true,
    "mapbox:type": "template",
    "description": "A clean, Uber-inspired delivery map style with muted land, crisp roads, restrained labels, and high-contrast routing overlays."
  },
  "center": [26.1025, 44.4268],
  "zoom": 12,
  "bearing": 0,
  "pitch": 0,
  "sprite": "mapbox://sprites/mapbox/light-v11",
  "glyphs": "mapbox://fonts/mapbox/{fontstack}/{range}.pbf",
  "sources": {
    "composite": {
      "url": "mapbox://mapbox.mapbox-streets-v8",
      "type": "vector"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#F4F5F2"
      }
    },
    {
      "id": "landuse-park",
      "type": "fill",
      "source": "composite",
      "source-layer": "landuse",
      "filter": [
        "match",
        ["get", "class"],
        ["park", "cemetery", "garden", "wood"],
        true,
        false
      ],
      "paint": {
        "fill-color": "#E5EBDD",
        "fill-opacity": 0.82
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "composite",
      "source-layer": "water",
      "paint": {
        "fill-color": "#DDE6EA"
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "composite",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-color": "#E8E8E5",
        "fill-outline-color": "#D8D8D4",
        "fill-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          14,
          0.28,
          16,
          0.55
        ]
      }
    },
    {
      "id": "road-path",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "filter": [
        "match",
        ["get", "class"],
        ["path", "pedestrian", "track", "steps"],
        true,
        false
      ],
      "paint": {
        "line-color": "#D8D8D2",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          13,
          0.4,
          17,
          1.3
        ],
        "line-opacity": 0.78
      }
    },
    {
      "id": "road-minor-casing",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "filter": [
        "match",
        ["get", "class"],
        ["street", "street_limited", "service"],
        true,
        false
      ],
      "paint": {
        "line-color": "#D7D7D1",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10,
          0.8,
          14,
          2.8,
          18,
          9
        ]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "filter": [
        "match",
        ["get", "class"],
        ["street", "street_limited", "service"],
        true,
        false
      ],
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10,
          0.5,
          14,
          1.8,
          18,
          7
        ]
      }
    },
    {
      "id": "road-primary-casing",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "filter": [
        "match",
        ["get", "class"],
        ["primary", "secondary", "tertiary", "trunk"],
        true,
        false
      ],
      "paint": {
        "line-color": "#C9C9C4",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          7,
          1,
          12,
          4.5,
          16,
          12
        ]
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "filter": [
        "match",
        ["get", "class"],
        ["primary", "secondary", "tertiary", "trunk"],
        true,
        false
      ],
      "paint": {
        "line-color": "#FFFFFF",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          7,
          0.6,
          12,
          3,
          16,
          9.5
        ]
      }
    },
    {
      "id": "motorway-casing",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "filter": [
        "match",
        ["get", "class"],
        ["motorway"],
        true,
        false
      ],
      "paint": {
        "line-color": "#BFC0BA",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          6,
          1.5,
          12,
          6,
          16,
          14
        ]
      }
    },
    {
      "id": "motorway",
      "type": "line",
      "source": "composite",
      "source-layer": "road",
      "filter": [
        "match",
        ["get", "class"],
        ["motorway"],
        true,
        false
      ],
      "paint": {
        "line-color": "#FDFDFB",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          6,
          1,
          12,
          4,
          16,
          11
        ]
      }
    },
    {
      "id": "transit",
      "type": "line",
      "source": "composite",
      "source-layer": "transit",
      "minzoom": 11,
      "paint": {
        "line-color": "#C9CBC6",
        "line-width": 1,
        "line-opacity": 0.42
      }
    },
    {
      "id": "poi-food",
      "type": "symbol",
      "source": "composite",
      "source-layer": "poi_label",
      "minzoom": 15,
      "filter": [
        "match",
        ["get", "maki"],
        ["restaurant", "cafe", "fast-food", "bar", "bakery"],
        true,
        false
      ],
      "layout": {
        "icon-image": ["coalesce", ["image", ["get", "maki"]], ["image", "restaurant"]],
        "icon-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          15,
          0.72,
          18,
          0.95
        ],
        "icon-allow-overlap": false,
        "text-field": ["get", "name"],
        "text-font": ["DIN Offc Pro Medium", "Arial Unicode MS Regular"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          15,
          10,
          18,
          12
        ],
        "text-offset": [0, 1],
        "text-anchor": "top",
        "text-max-width": 8,
        "text-optional": true
      },
      "paint": {
        "icon-color": "#1B8F5A",
        "icon-opacity": 0.9,
        "text-color": "#30332F",
        "text-halo-color": "#F4F5F2",
        "text-halo-width": 1.2,
        "text-opacity": 0.84
      }
    },
    {
      "id": "place-neighborhood",
      "type": "symbol",
      "source": "composite",
      "source-layer": "place_label",
      "minzoom": 11,
      "filter": [
        "match",
        ["get", "class"],
        ["neighbourhood", "suburb"],
        true,
        false
      ],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["DIN Offc Pro Medium", "Arial Unicode MS Regular"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          11,
          10,
          15,
          13
        ],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.06,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#8B8D87",
        "text-halo-color": "#F4F5F2",
        "text-halo-width": 1.4,
        "text-opacity": 0.72
      }
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "composite",
      "source-layer": "road",
      "minzoom": 13,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["get", "name"],
        "text-font": ["DIN Offc Pro Regular", "Arial Unicode MS Regular"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          13,
          10,
          17,
          12
        ],
        "text-pitch-alignment": "viewport",
        "text-rotation-alignment": "map"
      },
      "paint": {
        "text-color": "#6F716B",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1,
        "text-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          13,
          0.45,
          16,
          0.85
        ]
      }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "composite",
      "source-layer": "place_label",
      "filter": [
        "match",
        ["get", "class"],
        ["city", "town"],
        true,
        false
      ],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["DIN Offc Pro Medium", "Arial Unicode MS Regular"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5,
          13,
          10,
          17
        ],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#242622",
        "text-halo-color": "#F4F5F2",
        "text-halo-width": 1.6
      }
    }
  ]
}
