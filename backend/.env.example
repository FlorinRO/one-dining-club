DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081
DATABASE_URL=postgresql://one_dining:one_dining@localhost:5432/one_dining_club
DEFAULT_FROM_EMAIL=One Dining Club <no-reply@onedining.club>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_VERIFICATION_CONFIRM_URL=http://localhost:8000/api/auth/verify-email/confirm/?uid={uid}&token={token}
PASSWORD_RESET_CONFIRM_URL=onediningclub://reset-password?uid={uid}&token={token}
