{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "simulator": {
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_PRODUCTION_API_URL": "https://api.yumzy.ro/api"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6771113150"
      }
    }
  }
}
