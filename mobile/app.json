{
  "expo": {
    "owner": "connectionpoint",
    "name": "YUMZY",
    "slug": "one-dining-club",
    "scheme": "onediningclub",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#E53935"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "club.onedining.customer",
      "merchantIdentifier": "merchant.com.onediningclub",
      "icon": "./assets/ios-icon-yumzy.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "YUMZY folosește locația pentru restaurante și livrare.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "club.onedining.customer",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.onediningclub",
          "enableGooglePay": true
        }
      ],
      "expo-video",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "YUMZY folosește locația pentru restaurante și livrare."
        }
      ]
    ],
    "extra": {
      "productionApiUrl": "https://api.yumzy.ro/api",
      "stripePublishableKey": "pk_test_replace_me",
      "stripeMerchantIdentifier": "merchant.com.onediningclub",
      "stripeMerchantCountryCode": "RO",
      "stripeCurrencyCode": "RON",
      "stripeMerchantDisplayName": "YUMZY",
      "stripeReturnUrl": "onediningclub://stripe-redirect",
      "googleWebClientId": "",
      "googleIosClientId": "",
      "googleAndroidClientId": "",
      "facebookClientId": "1495672788475895",
      "eas": {
        "projectId": "d84264ea-fb7b-4d5e-8d1c-9d7cfb237cdf"
      }
    }
  }
}
